APP_NAME=ClaimIQ API
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+psycopg://labuser:YOUR_PASSWORD@localhost:5432/postgres
SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIRECTORY=storage/documents
MAX_UPLOAD_SIZE_MB=10
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_DIRECTORY=storage/vector_store
VECTOR_COLLECTION_NAME=claimiq_document_chunks