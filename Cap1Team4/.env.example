ENV=dev
DATABASE_URL=sqlite:///./claims.db
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=[]
DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_BYTES=10485760
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
AI_RATE_LIMIT_PER_MINUTE=30

# Docker Compose settings (replace placeholders in your local .env only).
POSTGRES_USER=claimsiq
POSTGRES_PASSWORD=replace-this-local-database-password
POSTGRES_DB=claimsiq
APP_PORT=8000
